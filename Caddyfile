# DOMAIN задаётся в docker-compose.yml (по умолчанию akhandev.ru).
# Caddy сам получит и будет продлевать сертификаты для домена и для www.

# www перенаправляется на основной адрес, чтобы в поиске не было дубликатов сайта.
www.{$DOMAIN:localhost} {
	redir https://{$DOMAIN:localhost}{uri} permanent
}

{$DOMAIN:localhost} {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Файлы в /_astro/ имеют хеш в имени и не меняются.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Превью, иконки и манифест: кеш на сутки, чтобы замена файла доходила быстро.
	@static path /og.png /favicon.svg /favicon-48.png /apple-touch-icon.png /icon-192.png /icon-512.png /site.webmanifest
	header @static Cache-Control "public, max-age=86400"

	file_server

	handle_errors {
		@notfound expression {err.status_code} == 404
		rewrite @notfound /404.html
		file_server {
			status 404
		}
	}
}
