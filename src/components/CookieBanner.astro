<aside class="cookie-banner" data-cookie-banner aria-labelledby="cookie-title" hidden>
  <h2 id="cookie-title" tabindex="-1">Cookie и статистика</h2>
  <p>Я использую Яндекс Метрику, чтобы понимать, откуда приходят на сайт. Она ставит cookie и записывает действия на странице. Включу её только с вашего согласия, без неё сайт работает так же.</p>
  <p class="cookie-status" data-consent-status role="status" hidden></p>
  <div class="cookie-actions">
    <button type="button" class="text-button" data-consent="granted">Принять</button>
    <button type="button" class="text-button" data-consent="denied">Отказаться</button>
  </div>
  <a class="cookie-link" href="/privacy/">Политика конфиденциальности</a>
</aside>

<style>
  .cookie-banner { position:fixed; z-index:18; left:24px; bottom:24px; width:min(440px, calc(100vw - 48px)); padding:20px; background:var(--dialog); border:1px solid var(--line); border-radius:4px; box-shadow:0 12px 40px rgb(0 0 0 / 28%); display:grid; gap:12px }
  .cookie-banner[hidden] { display:none }
  h2 { font-size:16px; font-weight:550; line-height:1.3; letter-spacing:-.2px }
  p { color:var(--secondary); font-size:13px; line-height:1.7 }
  .cookie-status { color:var(--text); font:11px/1.6 var(--mono) }
  .cookie-actions { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:4px }
  .cookie-actions button { min-height:46px; background:transparent; color:var(--text); cursor:pointer }
  .cookie-actions button:hover { background:var(--surface) }
  .cookie-link { justify-self:start; display:inline-flex; align-items:center; min-height:44px; margin-block:-8px -12px; font-size:12px; color:var(--muted); text-decoration:underline; text-underline-offset:4px }
  .cookie-link:hover { color:var(--text) }
  @media (prefers-reduced-motion:no-preference) {
    .cookie-banner { animation:cookie-in 260ms cubic-bezier(.2,.8,.2,1) both }
    @keyframes cookie-in { from { opacity:0; transform:translateY(12px) } }
  }
  @media (max-width:540px) {
    .cookie-banner { left:12px; right:12px; bottom:12px; width:auto; padding:16px }
  }
</style>

<script>
  import { metrikaId, consentKey, consentVersion } from '../lib/analytics';

  type Choice = 'granted' | 'denied';
  type YmFunction = { (...args: unknown[]): void; a?: IArguments[]; l?: number };
  declare global { interface Window { ym?: YmFunction } }

  const banner = document.querySelector<HTMLElement>('[data-cookie-banner]');
  const heading = document.querySelector<HTMLElement>('#cookie-title');
  const status = document.querySelector<HTMLElement>('[data-consent-status]');
  const isLocalHost = ['localhost', '127.0.0.1', '[::1]'].includes(location.hostname) || location.hostname.endsWith('.localhost');
  let metrikaLoaded = false;
  let opener: HTMLElement | null = null;

  function readChoice(): Choice | null {
    try {
      const data = JSON.parse(localStorage.getItem(consentKey) ?? 'null') as { v?: number; choice?: string } | null;
      if (data?.v !== consentVersion) return null;
      return data.choice === 'granted' || data.choice === 'denied' ? data.choice : null;
    } catch { return null; }
  }

  function writeChoice(choice: Choice) {
    try { localStorage.setItem(consentKey, JSON.stringify({ v: consentVersion, choice, at: new Date().toISOString() })); } catch { /* Без хранилища плашка спросит при следующем заходе. */ }
  }

  /** Код счётчика Яндекс Метрики. Вызывается только после согласия и не на локальном адресе, чтобы разработка не попадала в статистику. */
  function loadMetrika() {
    if (metrikaLoaded || isLocalHost) return;
    metrikaLoaded = true;
    const ym: YmFunction = window.ym ??= function () { (ym.a ??= []).push(arguments); };
    ym.l = Date.now();
    const script = document.createElement('script');
    script.async = true;
    script.src = `https://mc.yandex.ru/metrika/tag.js?id=${metrikaId}`;
    document.head.append(script);
    ym(metrikaId, 'init', { ssr: true, webvisor: true, clickmap: true, ecommerce: 'dataLayer', referrer: document.referrer, url: location.href, accurateTrackBounce: true, trackLinks: true });
  }

  /** Удаляет cookie Метрики (_ym...) для текущего адреса и его родительского домена. */
  function clearMetrikaCookies() {
    const host = location.hostname;
    const domains = [undefined, host, `.${host}`, `.${host.replace(/^www\./, '')}`];
    document.cookie.split(';').map(part => part.split('=')[0]?.trim() ?? '').filter(name => name.startsWith('_ym')).forEach(name => {
      domains.forEach(domain => { document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/${domain ? `; domain=${domain}` : ''}`; });
    });
  }

  function updateStatus(choice: Choice | null) {
    if (!status) return;
    status.hidden = choice === null;
    status.textContent = choice === 'granted' ? 'Сейчас статистика включена.' : choice === 'denied' ? 'Сейчас статистика выключена.' : '';
  }

  function show(fromSettings: boolean) {
    if (!banner) return;
    updateStatus(readChoice());
    banner.hidden = false;
    if (fromSettings) {
      opener = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      heading?.focus({ preventScroll: true });
    }
  }

  function hide() {
    if (!banner) return;
    banner.hidden = true;
    opener?.focus({ preventScroll: true });
    opener = null;
  }

  function decide(choice: Choice) {
    writeChoice(choice);
    if (choice === 'granted') {
      loadMetrika();
    } else {
      clearMetrikaCookies();
      // Уже запущенный счётчик остановить нельзя, поэтому страница перезагружается без него.
      if (metrikaLoaded) { location.reload(); return; }
    }
    hide();
  }

  banner?.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach(button => {
    button.addEventListener('click', () => decide(button.dataset['consent'] === 'granted' ? 'granted' : 'denied'));
  });
  document.querySelectorAll<HTMLElement>('[data-cookie-settings]').forEach(button => button.addEventListener('click', () => show(true)));
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && banner && !banner.hidden && readChoice() !== null) hide();
  });

  const stored = readChoice();
  if (stored === 'granted') loadMetrika();
  if (stored === null) show(false);
</script>
