---
import Layout from '../layouts/Layout.astro';
import { content } from '../config';
---
<Layout title={`404 | ${content.ui.notFound}`} noindex>
  <section class="not-found" aria-labelledby="error-heading">
    <div class="error-code" aria-hidden="true"><span>4</span><span class="missing-zero">0</span><span>4</span></div>
    <div class="error-copy">
      <h1 id="error-heading"><span class="sr-only">404. </span>{content.errorPage.heading}</h1>
      <p>{content.errorPage.description}</p>
      <div class="error-actions">
        <a class="action-button" href="/">{content.ui.backHome}</a>
        <a class="error-projects" href="/projects/">{content.errorPage.projectsLabel}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .not-found { display:grid; grid-template-columns:1.1fr 1fr; align-items:center; gap:clamp(40px,7vw,112px); min-height:calc(100svh - 175px); padding-block:64px 88px }
  .error-code { display:flex; justify-content:center; font-size:clamp(140px,24vw,360px); font-weight:600; letter-spacing:-.085em; line-height:1.1; padding-right:.08em; user-select:none }
  .missing-zero { display:inline-block; color:var(--accent); transform:translateY(-.025em) rotate(-9deg); -webkit-text-stroke:1.5px var(--accent); -webkit-text-fill-color:transparent }
  h1 { max-width:520px; font-size:clamp(32px,3.7vw,56px); line-height:1.15; letter-spacing:-.045em; font-weight:550; text-wrap:balance }
  .error-copy>p { max-width:430px; margin-top:24px; color:var(--secondary); font-size:16px; line-height:1.8 }
  .error-actions { display:flex; align-items:center; flex-wrap:wrap; gap:12px 28px; margin-top:32px }
  .error-projects { display:inline-flex; align-items:center; min-height:44px; font-size:14px; text-decoration:underline }
  @media (prefers-reduced-motion:no-preference) {
    .missing-zero { transition:transform 240ms ease }
    .error-code:hover .missing-zero,.not-found:focus-within .missing-zero { transform:translateY(.025em) rotate(8deg); animation:signal-break 380ms steps(2,end) }
    @keyframes signal-break { 25% { clip-path:inset(5% 0 48%); translate:5px 0 } 50% { clip-path:inset(42% 0 12%); translate:-4px 0 } 75% { clip-path:inset(0); translate:2px 0 } }
  }
  @media (max-width:760px) {
    .not-found { grid-template-columns:1fr; gap:24px; padding-block:32px 64px; min-height:calc(100svh - 250px) }
    .error-code { font-size:clamp(140px,38vw,270px); justify-content:flex-start }
    h1 { max-width:500px; font-size:clamp(30px,6vw,44px) }
    .error-copy>p { font-size:15px; margin-top:18px }
    .error-actions { margin-top:24px }
  }
</style>
