---
import { siteConfig, content } from '../config';
import '@fontsource-variable/onest';
import '../styles/global.css';
import Header from '../components/Header.astro';
import CommandPalette from '../components/CommandPalette.astro';
import AmbientBackground from '../components/AmbientBackground.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { buildGraph } from '../lib/seo';
import { metrikaId } from '../lib/analytics';
interface Props { title?: string; description?: string; noindex?: boolean; schema?: Record<string, unknown>[]; }
const { title = siteConfig.title, description = siteConfig.description, noindex = false, schema = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, siteConfig.url);
const ogImage = new URL('/og.png', siteConfig.url);
const ogImageAlt = `${siteConfig.name}. ${siteConfig.role}.`;
const graph = buildGraph({ path: Astro.url.pathname, title, description, extra: schema });
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#151518" />
    <script is:inline>
      // Сайт открывается в тёмной теме на всех устройствах. Светлая включается только переключателем и запоминается.
      (() => {
        let theme = 'dark';
        try { if (localStorage.getItem('akhan-theme-v2') === 'light') theme = 'light'; } catch {}
        document.documentElement.dataset.theme = theme;
        if (theme === 'light') document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#f4f4f2');
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.name} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta name="application-name" content={siteConfig.brand} />
    <meta name="apple-mobile-web-app-title" content={siteConfig.brand} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />
    <style>
      .footer-button { display:inline-flex; align-items:center; min-height:44px; padding:0; border:0; background:none; color:inherit; font:10px var(--mono); cursor:pointer }
      .footer-button:hover { color:var(--text) }
    </style>
  </head>
  <body id="top">
    <AmbientBackground />
    <a class="skip-link" href="#main">{content.ui.skip}</a>
    <Header />
    <main class="page-width" id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer page-width">
      <p>© {siteConfig.copyrightYear} {siteConfig.name}</p>
      <div>
        <a href="/privacy/">Конфиденциальность</a>
        <button class="footer-button" type="button" data-consent-settings>Настройки cookie</button>
        <span>{content.ui.builtWith}</span>
      </div>
    </footer>
    <CookieBanner />
    <noscript><div><img src={`https://mc.yandex.ru/watch/${metrikaId}`} style="position:absolute; left:-9999px;" alt="" /></div></noscript>
    <CommandPalette />
    <script src="../scripts/interactions.ts"></script>
  </body>
</html>
